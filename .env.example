# =============================================================================
# Corporate Lending Automation — Environment Configuration
# Copy this file to .env and fill in your values before running the server.
# =============================================================================

# --------------- Application --------------------------------------------------
APP_NAME=Corporate Lending Automation
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# --------------- Security (CHANGE IN PRODUCTION) -----------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-char-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --------------- Database -----------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/corporate_lending

# --------------- Redis --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --------------- Celery (Background Jobs) -------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --------------- File Storage (relative to project root) ---------------------
UPLOAD_DIR=uploads
REPORT_DIR=reports
RESULTS_DIR=results
LOG_DIR=logs
MODELS_DIR=models

# --------------- Dataset (relative to project root) --------------------------
DATASET_PATH=datasets/company_bankruptcy_prediction.csv

# --------------- OCR ----------------------------------------------------------
# Windows: C:/Program Files/Tesseract-OCR/tesseract.exe
# Linux/Mac: tesseract
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_LANG=eng
OCR_DPI=300
MAX_FILE_SIZE_MB=50

# --------------- Machine Learning ---------------------------------------------
ML_RANDOM_STATE=42
TEST_SIZE=0.2
CV_FOLDS=5

# --------------- Rate Limiting ------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# --------------- CORS ---------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --------------- Logging ------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
